APP_JWT_SECRET=<generate with: openssl rand -hex 32>
APP_CRYPTO_ELECTION_KEY_SECRET=<generate with: openssl rand -hex 32>
APP_DB_URL=jdbc:postgresql://localhost:5432/escomvoting
APP_DB_USERNAME=escom
APP_DB_PASSWORD=escom

# Outgoing mail — Gmail account + 16-char App Password (Google Account → Security → App passwords)
APP_MAIL_USERNAME=youraccount@gmail.com
APP_MAIL_PASSWORD=<gmail app password, no spaces>
APP_MAIL_FROM=youraccount@gmail.com
APP_MAIL_ENABLED=true
APP_FRONTEND_URL=http://localhost:44100
